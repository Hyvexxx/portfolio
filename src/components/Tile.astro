---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import { fullSize, placeholder, widthsFor } from '../lib/images';
import { getWatermark, projectUrl, tagKey, type Project } from '../lib/projects';

interface Props {
  image: ImageMetadata;
  alt: string;
  project: Project;
  /** Ukázat název projektu (v pohledu „Všechny práce“). */
  showProject?: boolean;
  /** Musí odpovídat počtu sloupců masonry (viz --min-col v global.css). */
  sizes: string;
  /** view-transition-name pro plynulý přechod z karty projektu. */
  transitionName?: string;
}

const { image, alt, project, showProject = false, sizes, transitionName } = Astro.props;
const watermark = await getWatermark();
const full = await fullSize(image, watermark);
const ph = await placeholder(image);
const href = projectUrl(project);
const style = [
  transitionName && `view-transition-name: ${transitionName}`,
  ph && `--ph: ${ph}`,
]
  .filter(Boolean)
  .join('; ');
---

<figure
  class="tile fade"
  data-item
  data-category={project.category}
  data-tags={project.tags.map(tagKey).join('|')}
  data-ratio={(image.height / image.width).toFixed(4)}
  style={style || undefined}
>
  <a
    href={full.src}
    data-pswp-width={full.width}
    data-pswp-height={full.height}
    data-title={showProject ? project.title : undefined}
    data-project-url={showProject ? href : undefined}
  >
    <Image
      src={image}
      alt={alt}
      widths={widthsFor(image, [400, 700, 1000, 1400])}
      sizes={sizes}
      format="webp"
      quality={80}
      watermark={watermark}
    />
  </a>
  {
    showProject && (
      <a class="tile-caption" href={href}>
        <span>{project.title}</span>
        <Arrow />
      </a>
    )
  }
</figure>
