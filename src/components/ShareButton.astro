---
import Arrow from './Arrow.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<button class="pill pill--share" type="button" data-share data-title={title}>
  <span data-share-label>Sdílet</span>
  <Arrow />
</button>

<script>
  // Na mobilu otevře systémové sdílení, jinde zkopíruje odkaz do schránky.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
    const label = button.querySelector<HTMLElement>('[data-share-label]');
    const original = label?.textContent ?? '';
    let timer: number | undefined;

    const flash = (text: string) => {
      if (!label) return;
      label.textContent = text;
      button.dataset.done = '';
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        label.textContent = original;
        delete button.dataset.done;
      }, 2000);
    };

    button.addEventListener('click', async () => {
      const data = { title: button.dataset.title ?? document.title, url: location.href };
      const touch = matchMedia('(hover: none)').matches;
      if (touch && navigator.share) {
        try {
          await navigator.share(data);
        } catch {
          // zavřený dialog sdílení – nic nehlásíme
        }
        return;
      }
      try {
        await navigator.clipboard.writeText(data.url);
        flash('Odkaz zkopírován');
      } catch {
        flash('Kopírování se nepovedlo');
      }
    });
  }
</script>
