---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Arrow from '../components/Arrow.astro';
import { getSite, url } from '../lib/projects';

interface Props {
  title?: string;
  description?: string;
  image?: ImageMetadata;
  nav?: 'work' | 'about';
}

const { title, description, image, nav } = Astro.props;
const site = await getSite();

const pageTitle = title ? `${title} — ${site.name}` : site.name;
const pageDescription = description ?? site.intro ?? site.tagline ?? '';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSource = image ?? site.portrait;
const ogImage = ogSource
  ? await getImage({ src: ogSource, width: Math.min(ogSource.width, 1200), format: 'jpg' })
  : undefined;
const initials = site.name
  .split(/\s+/)
  .map((word) => word[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {pageDescription && <meta name="description" content={pageDescription} />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0a0b" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage.src, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body id="top">
    <header class="wrap site-header">
      <a class="brand" href={url('/')}>
        <span class="brand-mark" aria-hidden="true">{initials}</span>
        <span class="brand-name">{site.name}</span>
      </a>
      <nav class="site-nav" aria-label="Hlavní navigace">
        <a href={url('/')} aria-current={nav === 'work' ? 'page' : undefined}>Práce</a>
        <a href={url('/o-mne/')} aria-current={nav === 'about' ? 'page' : undefined}>O mně</a>
        {site.email && <a class="btn" href={`mailto:${site.email}`}>Kontakt</a>}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap site-footer">
      <div class="footer-card">
        <p class="label"><span class="dot"></span>Kontakt</p>
        <h2 class="footer-title">{site.cta ?? 'Pojďme spolupracovat.'}</h2>
        {
          site.email && (
            <a class="footer-mail" href={`mailto:${site.email}`}>
              <span class="text">{site.email}</span>
              <span class="circle">
                <Arrow />
              </span>
            </a>
          )
        }
        <div class="footer-bottom">
          <p>© {year} {site.name}</p>
          <ul>
            {
              site.instagram && (
                <li>
                  <a href={site.instagram} rel="me">
                    Instagram <Arrow />
                  </a>
                </li>
              )
            }
            {
              site.behance && (
                <li>
                  <a href={site.behance} rel="me">
                    Behance <Arrow />
                  </a>
                </li>
              )
            }
            <li>
              <a href="#top">
                Nahoru <Arrow direction="up" />
              </a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>
