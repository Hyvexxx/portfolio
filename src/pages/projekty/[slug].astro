---
import type { GetStaticPaths } from 'astro';
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Arrow from '../../components/Arrow.astro';
import JsonLd from '../../components/JsonLd.astro';
import Lightbox from '../../components/Lightbox.astro';
import Masonry from '../../components/Masonry.astro';
import ShareButton from '../../components/ShareButton.astro';
import Tile from '../../components/Tile.astro';
import { placeholder, widthsFor } from '../../lib/images';
import {
  CATEGORIES,
  displayUrl,
  getProjects,
  getSite,
  pad,
  plainText,
  projectUrl,
  tagKey,
  transitionName,
  url,
} from '../../lib/projects';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((project, i) => ({
    params: { slug: project.id },
    // Další projekt dokola – za posledním následuje první.
    props: { project, next: projects.length > 1 ? projects[(i + 1) % projects.length] : undefined },
  }));
}) satisfies GetStaticPaths;

const { project, next } = Astro.props;
const { Content } = await render(project.entry);
const site = await getSite();
const description = plainText(project.entry.body);
const nextPh = next ? await placeholder(next.cover) : undefined;

const cover = await getImage({ src: project.cover, width: Math.min(project.cover.width, 1200), format: 'jpg' });
const schema = {
  '@type': 'CreativeWork',
  name: project.title,
  description: description || undefined,
  dateCreated: project.date.toISOString().slice(0, 10),
  genre: CATEGORIES[project.category],
  keywords: project.tags.join(', ') || undefined,
  image: new URL(cover.src, Astro.site).href,
  url: new URL(projectUrl(project), Astro.site).href,
  locationCreated: project.location ? { '@type': 'Place', name: project.location } : undefined,
  creator: { '@type': 'Person', name: site.name },
};
---

<Base
  title={project.title}
  description={description || undefined}
  nav="work"
  image={project.cover}
  imageAlt={project.title}
>
  <JsonLd slot="head" data={schema} />

  <article class="wrap">
    <div class="project-top">
      <a class="pill pill--back" href={url('/')}><Arrow direction="left" /> Všechny projekty</a>
      <ShareButton title={project.title} />
    </div>

    <header class="project-hero">
      <p class="label"><span class="dot"></span>{CATEGORIES[project.category]} — {project.year}</p>
      <h1 class="project-title">{project.title}</h1>
    </header>

    <div class="project-info">
      <dl class="facts">
        <div>
          <dt class="label">Kategorie</dt>
          <dd>{CATEGORIES[project.category]}</dd>
        </div>
        <div>
          <dt class="label">Rok</dt>
          <dd>{project.year}</dd>
        </div>
        <div>
          <dt class="label">Obrázky</dt>
          <dd>{pad(project.images.length)}</dd>
        </div>
        {
          project.client && (
            <div>
              <dt class="label">Klient</dt>
              <dd>{project.client}</dd>
            </div>
          )
        }
        {
          project.location && (
            <div>
              <dt class="label">Místo</dt>
              <dd>{project.location}</dd>
            </div>
          )
        }
        {
          project.link && (
            <div>
              <dt class="label">Odkaz</dt>
              <dd>
                <a href={project.link} target="_blank" rel="noopener">
                  <span>{displayUrl(project.link)}</span>
                  <Arrow />
                </a>
              </dd>
            </div>
          )
        }
        {
          project.tags.length > 0 && (
            <div class="facts-wide">
              <dt class="label">Tagy</dt>
              <dd class="tag-list">
                {project.tags.map((tag) => (
                  <a class="chip" href={`${url('/')}?tag=${encodeURIComponent(tagKey(tag))}`}>
                    #{tag}
                  </a>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
      <div class="prose">
        <Content />
      </div>
    </div>

    <Masonry large>
      {
        project.images.map((image, i) => (
          <Tile
            image={image}
            alt={`${project.title} – ${i + 1}`}
            project={project}
            sizes="(min-width: 1290px) 33vw, (min-width: 850px) 50vw, 100vw"
            transitionName={i === 0 ? transitionName(project) : undefined}
          />
        ))
      }
    </Masonry>

    {
      next && (
        <a class="next-project" href={projectUrl(next)}>
          <div>
            <p class="label">Další projekt</p>
            <p class="next-title">
              {next.title} <Arrow direction="right" />
            </p>
          </div>
          <div class="next-media fade" style={nextPh ? `--ph: ${nextPh}` : undefined}>
            <Image
              src={next.cover}
              alt=""
              widths={widthsFor(next.cover, [300, 600])}
              sizes="(min-width: 1400px) 280px, 20vw"
              format="webp"
              quality={80}
            />
          </div>
        </a>
      )
    }
  </article>

  <Lightbox />
</Base>
