---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import JsonLd from '../components/JsonLd.astro';
import { placeholder, widthsFor } from '../lib/images';
import { displayUrl, getSite, personSchema } from '../lib/projects';

const site = await getSite();
const { Content } = await render(site.entry);
const ph = site.portrait ? await placeholder(site.portrait) : undefined;

const links = [
  ...(site.email ? [{ label: 'E-mail', text: site.email, href: `mailto:${site.email}`, me: false }] : []),
  ...site.socials.map((s) => ({ label: s.name, text: displayUrl(s.url), href: s.url, me: true })),
];
---

<Base title="O mně" nav="about" imageAlt={site.name}>
  <JsonLd slot="head" data={await personSchema(site, Astro.site)} />

  <section class="wrap about">
    {
      site.portrait && (
        <div class="about-media fade" style={ph ? `--ph: ${ph}` : undefined}>
          <Image
            class="about-portrait"
            src={site.portrait}
            alt={site.name}
            widths={widthsFor(site.portrait, [480, 800, 1200])}
            sizes="(min-width: 900px) 40vw, 100vw"
            format="webp"
            loading="eager"
          />
        </div>
      )
    }
    <div>
      <p class="label"><span class="dot"></span>O mně</p>
      <h1 class="about-title">{site.name}</h1>
      {site.tagline && <p class="about-lead">{site.tagline}</p>}
      <div class="prose">
        <Content />
      </div>
      {
        links.length > 0 && (
          <ul class="links">
            {links.map((link) => (
              <li>
                <a href={link.href} rel={link.me ? 'me' : undefined}>
                  <span class="label">{link.label}</span>
                  <span>{link.text}</span>
                  <Arrow />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
</Base>
